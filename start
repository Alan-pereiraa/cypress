#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

PYTHON_BIN=""

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v php >/dev/null 2>&1 || { ! command -v python3 >/dev/null 2>&1 && ! command -v python >/dev/null 2>&1; }; then
  echo "Dependências ausentes. Executando ./build..."
  bash "$ROOT_DIR/build"
fi

if ! command -v php >/dev/null 2>&1; then
  echo "Erro: PHP não encontrado após executar ./build."
  exit 1
fi

if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
else
  echo "Erro: Python não encontrado após executar ./build."
  exit 1
fi

cleanup() {
  trap - EXIT INT TERM
  kill "$BACK_PID" "$FRONT_PID" 2>/dev/null || true
  wait "$BACK_PID" "$FRONT_PID" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

php -S localhost:8000 -t "$ROOT_DIR/back/public" &
BACK_PID=$!

"$PYTHON_BIN" -m http.server 5500 --directory "$ROOT_DIR/front/public" &
FRONT_PID=$!

echo "API:      http://localhost:8000"
echo "Frontend: http://localhost:5500"
echo "Pressione Ctrl+C para encerrar os dois servidores."

wait "$BACK_PID" "$FRONT_PID"
